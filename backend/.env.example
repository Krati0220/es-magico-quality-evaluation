# Backend environment variables (Render + local dev)
# Never commit a real .env file.

# --- Primary Summariser (Groq recommended) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=gsk_YOUR_GROQ_API_KEY

# --- Optional Separate Judge (recommended to avoid self-bias) ---
# Option A: Stronger model on Groq
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_API_KEY=gsk_YOUR_GROQ_API_KEY

# Option B: Cross-provider judge (e.g., Gemini OpenAI-compatible endpoint)
# JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# JUDGE_MODEL=gemini-2.5-flash
# JUDGE_API_KEY=YOUR_GEMINI_API_KEY

# --- Persistence (omit locally to use SQLite; Render injects DATABASE_URL for Postgres) ---
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Security (HIGHLY RECOMMENDED for Render/Vercel deployment) ---
# Protects confidential assignment data and your LLM API credits.
APP_ACCESS_TOKEN=change-me-to-a-strong-secret-token

# --- CORS (set to your Vercel frontend URL in production, comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional Groq Free-Tier Pacing (seconds between calls; e.g. 2.5 for 8k TPM) ---
RATE_LIMIT_MIN_DELAY_SECONDS=0.0
