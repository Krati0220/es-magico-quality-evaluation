# Copy this to .env and replace placeholders locally. Never paste secrets in chat.
# The CLI loads literal settings from .env; existing environment variables win.
LLM_BASE_URL=YOUR_OPENAI_COMPATIBLE_BASE_URL
LLM_MODEL=YOUR_AVAILABLE_MODEL
LLM_API_KEY=YOUR_API_KEY_IF_REQUIRED
# For an installed compatible local server, BASE_URL can be http://localhost:11434/v1
# and the API_KEY line can be removed if not required by that server.
# Optional judge override; defaults to the summariser endpoint/model/key.
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_MODEL=REPLACE_WITH_AVAILABLE_MODEL
# JUDGE_API_KEY=REPLACE_WITH_YOUR_KEY_IF_REQUIRED
